---
import PageShell from './ui/PageShell.astro';
import { focusRing } from '../lib/classes';

const year = new Date().getFullYear();
const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/dazuaz' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/daniel-zuloaga/' },
  { label: 'X', href: 'https://x.com/danielzuloaga' },
];
---

<footer class="mt-2xl">
  <PageShell as="div" class="flex flex-wrap items-center justify-between gap-x-lg gap-y-sm border-t border-rule py-lg font-ui text-xs text-meta">
    <p>© {year} Daniel Zuloaga</p>
    <nav class="flex flex-wrap items-center gap-x-lg gap-y-xs" aria-label="Social links">
      {socialLinks.map((link) => (
        <a class:list={[focusRing, 'inline-flex min-h-11 items-center gap-xs hover:text-accent']} href={link.href} target="_blank" rel="noopener noreferrer">
          {link.label} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in new tab)</span>
        </a>
      ))}
      <a class:list={[focusRing, 'inline-flex min-h-11 items-center hover:text-accent']} href="/rss.xml">RSS</a>
    </nav>
  </PageShell>
</footer>
