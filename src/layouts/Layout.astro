---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BotIdProtection from '../components/BotIdProtection';

import { canonicalUrl, identityGraph, serializeJsonLd, siteIdentity } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  nav?: 'home' | 'blog' | 'contact' | 'services' | 'approach' | 'about' | 'work';
  noindex?: boolean;
  pageType?: 'WebPage' | 'CollectionPage' | 'ContactPage';
  structuredData?: Record<string, unknown>[];
}

const {
  title = siteIdentity.title,
  description = siteIdentity.description,
  ogImage = siteIdentity.image,
  ogImageAlt = siteIdentity.imageAlt,
  ogType = 'website',
  pubDate,
  updatedDate,
  nav = 'home',
  noindex = false,
  pageType = 'WebPage',
  structuredData = [],
} = Astro.props;

const siteOrigin = Astro.site!;
const canonicalURL = canonicalUrl(Astro.url.pathname, siteOrigin);
const ogImageURL = new URL(ogImage, siteOrigin).toString();
const home = canonicalUrl('/', siteOrigin);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...identityGraph(siteOrigin),
    {
      '@type': pageType,
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      inLanguage: 'en-US',
      isPartOf: { '@id': `${home}#website` },
      ...(ogType === 'article' ? { mainEntity: { '@id': `${canonicalURL}#article` } } : {}),
    },
    ...structuredData,
  ],
};

const fontHref =
	'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@400;500;600&display=swap';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{!noindex && <link rel="canonical" href={canonicalURL} />}
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
		{ogType === 'article' && <meta name="author" content={siteIdentity.author} />}
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Daniel Zuloaga — Writing"
			href={new URL('rss.xml', siteOrigin)}
		/>

		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content="en_US" />
		{ogImage === siteIdentity.image && <meta property="og:image:type" content="image/png" />}
		{ogImage === siteIdentity.image && <meta property="og:image:width" content="1200" />}
		{ogImage === siteIdentity.image && <meta property="og:image:height" content="630" />}
		<meta property="og:site_name" content="Zulo" />
		{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@danielzuloaga" />
		<meta name="twitter:creator" content="@danielzuloaga" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		{!noindex && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" as="style" href={fontHref} />
		<link href={fontHref} rel="stylesheet" />
		{import.meta.env.PROD && nav === 'contact' && <BotIdProtection />}
	</head>
	<body class="min-h-screen bg-bg font-body text-base leading-body text-ink antialiased [font-kerning:normal] [font-optical-sizing:auto]">
		<a
			class="absolute -top-full left-4 z-skip rounded-lg bg-accent px-4 py-2.5 font-ui text-sm font-semibold leading-ui text-white transition-[top] duration-150 ease-out focus:top-4 focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-accent motion-reduce:transition-none"
			href="#main-content"
		>
			Skip to content
		</a>
		<SiteNav current={nav} />
		<slot />
		<SiteFooter />
	</body>
</html>
