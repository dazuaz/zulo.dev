---
import Layout from './Layout.astro';
import MarkdownProse from '../components/ui/MarkdownProse.astro';
import PageShell from '../components/ui/PageShell.astro';
import PromptCopyEnhancer from '../components/PromptCopyEnhancer';
import { displayTitle, focusRing, metaText, proseLead } from '../lib/classes';
import { cn } from '../lib/utils';
import { canonicalUrl, siteIdentity } from '../lib/seo';
import { getBlogImage } from '../lib/blog-images';
import { articleImageSizes } from '../lib/blog-image-markup';

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  heroImage,
  heroImageAlt,
  heroImageWidth,
  heroImageHeight,
  slug,
  minutes,
  newerPost,
  olderPost,
} = Astro.props;
const responsiveHero = heroImage ? await getBlogImage(heroImage) : undefined;
const heroSource = responsiveHero?.src ?? heroImage;
const pageUrl = canonicalUrl(`/blog/${slug}`, Astro.site!);
const home = canonicalUrl('/', Astro.site!);
const articleSchema = [
  {
    '@type': 'BlogPosting',
    '@id': `${pageUrl}#article`,
    url: pageUrl,
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
    author: { '@id': `${home}#person` },
    publisher: { '@id': `${home}#organization` },
    mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
    inLanguage: 'en-US',
    keywords: tags,
    ...(heroImage ? { image: new URL(heroSource, Astro.site).toString() } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: home },
      { '@type': 'ListItem', position: 2, name: 'Insights', item: canonicalUrl('/blog', Astro.site!) },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
const formatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
const publishedLabel = formatter.format(pubDate);
const updatedLabel = updatedDate ? formatter.format(updatedDate) : null;
---

<Layout
  title={`${title} | Daniel Zuloaga`}
  description={description}
  ogType="article"
  ogImage={heroSource ?? siteIdentity.image}
  ogImageAlt={heroImage ? (heroImageAlt ?? title) : siteIdentity.imageAlt}
  structuredData={articleSchema}
  pubDate={pubDate}
  updatedDate={updatedDate}
  nav="blog"
>
  <main id="main-content">
    <PageShell as="article" class="pb-section-lg">
      <header class="mx-auto flex max-w-[40rem] flex-col gap-md pt-page-intro pb-lg">
        <nav class="flex items-center gap-xs font-ui text-sm font-medium leading-ui text-accent" aria-label="Breadcrumb">
          <a class={focusRing} href="/">Home</a>
          <span class="select-none text-meta" aria-hidden="true">/</span>
          <a class={focusRing} href="/blog">Insights</a>
        </nav>
        <h1 class={displayTitle}>{title}</h1>
        <p class={cn(proseLead, 'max-w-none max-sm:leading-[1.55]')}>{description}</p>

        <div class={cn(metaText, 'flex flex-wrap items-center gap-x-xs gap-y-2xs [&>*+*]:before:mr-xs [&>*+*]:before:text-border-strong [&>*+*]:before:content-["·"]')}>
          <a href="/about" rel="author" class={cn(focusRing, 'text-ink max-sm:basis-full')}>By {siteIdentity.author}</a>
          <time class="max-sm:before:hidden" datetime={pubDate.toISOString()}>{publishedLabel}</time>
          {minutes && <span>{minutes} min read</span>}
          {updatedLabel && <span class="max-sm:basis-full max-sm:before:hidden">Updated <time datetime={updatedDate.toISOString()}>{updatedLabel}</time></span>}
        </div>

        {
          tags?.length ? (
            <div class="flex flex-wrap items-center gap-xs">
              {tags.map((tag) => (
                <span class="inline-flex items-center rounded-md border border-rule bg-bg px-2 py-1 font-ui text-xs font-medium leading-ui text-muted">{tag}</span>
              ))}
            </div>
          ) : null
        }
      </header>

      <div class="mx-auto w-full max-w-[40rem]">
        {
          heroImage ? (
            <figure class="mb-lg w-full sm:mb-xl">
              <img
                class="block h-auto w-full rounded-lg border border-border"
                src={heroSource}
                srcset={responsiveHero?.srcset}
                sizes={responsiveHero ? articleImageSizes : undefined}
                width={responsiveHero?.width ?? heroImageWidth}
                height={responsiveHero?.height ?? heroImageHeight}
                alt={heroImageAlt ?? `${title} main image`}
                loading="eager"
                decoding="async"
              />
            </figure>
          ) : null
        }

        <div>
          <MarkdownProse>
            <slot />
          </MarkdownProse>
        </div>

        {
          newerPost || olderPost ? (
            <nav class="mt-2xl grid gap-lg border-t border-rule pt-lg sm:grid-cols-2 sm:gap-xl" aria-label="More writing">
              {olderPost && (
                <a class={cn(focusRing, 'group flex flex-col gap-2xs rounded-sm', !newerPost && 'sm:col-span-2')} href={`/blog/${olderPost.slug}`} rel="prev">
                  <span class={metaText}><span aria-hidden="true">← </span>Older</span>
                  <span class="text-balance font-display text-base font-semibold leading-heading tracking-[-0.015em] text-ink transition-colors duration-150 ease-out group-hover:text-accent motion-reduce:transition-none">{olderPost.title}</span>
                </a>
              )}
              {newerPost && (
                <a
                  class={cn(focusRing, 'group flex flex-col gap-2xs rounded-sm', olderPost ? 'sm:col-start-2 sm:text-right' : 'sm:col-span-2')}
                  href={`/blog/${newerPost.slug}`}
                  rel="next"
                >
                  <span class={metaText}>Newer<span aria-hidden="true"> →</span></span>
                  <span class="text-balance font-display text-base font-semibold leading-heading tracking-[-0.015em] text-ink transition-colors duration-150 ease-out group-hover:text-accent motion-reduce:transition-none">{newerPost.title}</span>
                </a>
              )}
            </nav>
          ) : null
        }
      </div>
    </PageShell>
  </main>
  <PromptCopyEnhancer client:load slug={slug} />
</Layout>

<script>
  import '../components/blog-figures/runtime';

  // Code blocks that scroll sideways must be reachable by keyboard.
  for (const pre of document.querySelectorAll<HTMLElement>('#main-content pre')) {
    const update = () => {
      if (pre.scrollWidth - pre.clientWidth > 1 && !pre.hasAttribute('tabindex')) pre.tabIndex = 0;
    };
    new ResizeObserver(update).observe(pre);
  }
</script>
