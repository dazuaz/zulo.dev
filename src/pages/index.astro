---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import PageShell from "../components/ui/PageShell.astro";
import PostList from "../components/PostList.astro";
import { getCollection } from "astro:content";
import {
    displayTitle,
    proseBody,
    proseLead,
    sectionTitle,
} from "../lib/classes";

const contactHref = "/contact";

const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 4);
---

<Layout
    title="Daniel Zuloaga"
    description="Daniel Zuloaga builds AI products for regulated lending. Notes on agents, product work, and what breaks in production."
    nav="home"
>
    <main id="main-content">
        <PageShell class="py-page-intro">
            <div
                class="grid items-start gap-xl md:grid-cols-[minmax(11rem,15rem)_minmax(0,1fr)] md:gap-2xl lg:grid-cols-[minmax(13rem,17.5rem)_minmax(0,1fr)] lg:gap-3xl"
            >
                <figure class="m-0 hidden md:block">
                    <img
                        class="block aspect-3/4 h-auto w-full rounded-lg border border-border object-cover object-[center_20%]"
                        src="/hero-kitesurf.webp"
                        alt="Watercolor of Daniel kitesurfing with his son on a sunny day in Miami"
                        width="1086"
                        height="1448"
                        loading="eager"
                        decoding="async"
                    />
                </figure>
                <div class="flex flex-col gap-lg">
                    <h1 class={displayTitle}>Daniel Zuloaga</h1>
                    <p class={proseLead}>
                        I build AI products for lending teams.
                    </p>
                    <p class={proseBody}>
                        I'm a software engineer and product manager with an MBA.
                        I turn messy lending workflows into software that teams
                        can run in production.
                    </p>
                    <div>
                        <Button href={contactHref}>Get in touch</Button>
                    </div>
                </div>
            </div>
        </PageShell>

        <PageShell
            class="grid gap-xl py-section md:grid-cols-2 md:gap-2xl lg:grid-cols-[1.12fr_0.88fr] lg:gap-3xl"
        >
            <div class="flex flex-col gap-md">
                <h2 class={sectionTitle}>What I'm building now</h2>
                <p class={proseBody}>
                    I'm building agents that handle work from lead generation
                    through loan servicing. They ingest documents, call tools,
                    retrieve context from internal data, and connect to company
                    systems through custom MCP servers. Making those pieces work
                    is getting easier. Deciding what deserves automation and
                    earning users' trust is still the hard part.
                </p>
            </div>
            <div class="flex flex-col gap-md">
                <h2 class={sectionTitle}>What's changed</h2>
                <p class={proseBody}>
                    AI has collapsed product and engineering into one job for
                    me. I can find a workflow problem in the morning and ship a
                    working agent that afternoon. The speed is great, and a
                    little deceptive. Code arrives faster than good judgment. I
                    still have to decide where the agent belongs and what happens
                    when it is wrong. Then comes the bluntest test. Does anyone
                    want it?
                </p>
            </div>
        </PageShell>

        <PageShell class="py-section">
            <div class="flex flex-wrap items-end justify-between gap-md">
                <div class="flex flex-col gap-xs">
                    <h2 class={sectionTitle}>Recent notes</h2>
                    <p class={proseBody}>
                        Notes from building agents in production.
                    </p>
                </div>
                <Button href="/blog" variant="secondary">
                    View all writing
                </Button>
            </div>

            <PostList posts={recentPosts} class="mt-lg" />
        </PageShell>

        <PageShell class="pb-page-end">
            <div
                class="rounded-lg bg-ink-deep p-section-lg text-[oklch(0.94_0.01_255)]"
            >
                <div
                    class="flex flex-col gap-lg sm:flex-row sm:items-center sm:justify-between"
                >
                    <div class="flex flex-col gap-sm">
                        <h2
                            class="text-balance font-display text-section font-semibold leading-heading tracking-[-0.015em] text-[oklch(0.97_0.005_255)]"
                        >
                            Need to untangle a stubborn workflow?
                        </h2>
                    </div>
                    <div class="flex shrink-0 flex-wrap items-center gap-sm">
                        <Button href={contactHref} variant="primaryOnDark">
                            Get in touch
                        </Button>
                        <Button
                            href="https://www.linkedin.com/in/daniel-zuloaga/"
                            variant="outlineOnDark"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Connect on LinkedIn
                            <span class="sr-only"> (opens in new tab)</span>
                        </Button>
                    </div>
                </div>
            </div>
        </PageShell>
    </main>
</Layout>
