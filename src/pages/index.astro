---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/ui/PageShell.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { accentLink, focusRing, sectionTitle } from '../lib/classes';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout
  title="Daniel Zuloaga"
  description="Daniel Zuloaga builds AI products for lending. Notes on finding opportunities, earning customer trust, and making the business and technology work together."
  nav="home"
>
  <main id="main-content">
    <PageShell as="div">
      <header class="masthead">
        <p class="eyebrow">The personal website of</p>
        <h1>Daniel Zuloaga<span class="text-accent">.</span></h1>
      </header>

      <section class="introduction" aria-labelledby="introduction-heading">
        <div class="bio">
          <p class="eyebrow text-accent">Business, product &amp; technology</p>
          <h2 id="introduction-heading">I build useful products.<br /><em>And write about<br />what I learn.</em></h2>
          <p>My work is in lending, finding places where AI can solve a problem worth paying to fix. <a class={accentLink} href="/blog/building-products-for-agents">Loan onboarding</a> is one example of how I think about that opportunity.</p>
          <p>Engineering, product, and an MBA. I’m comfortable moving between the business case and the code, and taking responsibility for what happens after launch.</p>
          <a class:list={[focusRing, 'hello-link']} href="/contact">Let’s talk <span aria-hidden="true">↗</span></a>
        </div>
        <figure>
          <img
            src="/hero-kitesurf.webp"
            alt="Illustration of Daniel kitesurfing with his son in Miami"
            width="1086"
            height="1448"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption><span>Away from the keyboard</span><span>Miami, FL</span></figcaption>
        </figure>
      </section>

      <section class="fieldnotes" aria-labelledby="fieldnotes-heading">
        <div class="flex flex-wrap items-center justify-between gap-md py-lg">
          <h2 id="fieldnotes-heading" class={sectionTitle}>Fieldnotes</h2>
          <a class:list={[focusRing, 'text-sm hover:text-accent']} href="/blog">All writing <span aria-hidden="true">↗</span></a>
        </div>
        <PostList posts={recentPosts} compact />
      </section>
    </PageShell>
  </main>
</Layout>

<style>
  .eyebrow { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; }
  .masthead { padding: clamp(2rem, 4vw, 3rem) 0; border-bottom: 1px solid var(--color-rule); }
  .masthead h1 { margin-top: 0.4rem; font-family: var(--font-display); font-size: clamp(3.25rem, 10vw, 7rem); font-weight: 400; line-height: 1.1; letter-spacing: -0.035em; }
  .introduction { display: grid; grid-template-columns: 1.13fr 0.87fr; gap: 8%; align-items: center; padding: clamp(2rem, 4vw, 3rem) 0; }
  .bio h2 { margin: 1.25rem 0; font-family: var(--font-display); font-size: clamp(2.5rem, 4.4vw, 3.5rem); font-weight: 400; line-height: 1.12; letter-spacing: -0.015em; }
  .bio h2 em { color: var(--color-muted); }
  .bio > p:not(.eyebrow) { max-width: 25rem; margin-top: 1rem; line-height: 1.65; }
  .hello-link { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 2rem; margin-top: 1.5rem; padding: 0.5rem 0; border-bottom: 1px solid currentColor; color: var(--color-accent); font-size: 0.875rem; }
  .hello-link:hover { color: var(--color-accent-hover); }
  figure img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 70%; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; margin-top: 0.75rem; color: var(--color-meta); font-size: 0.75rem; letter-spacing: 0.06em; }
  figcaption span:first-child { text-transform: uppercase; }
  .fieldnotes { border-top: 2px solid var(--color-ink); }
  @media (max-width: 640px) {
    .introduction { grid-template-columns: 1fr; gap: 2rem; }
    .bio h2 { font-size: clamp(2.5rem, 8vw, 3.5rem); }
    figure img { aspect-ratio: 4 / 3; object-position: center 62%; }
  }
</style>
