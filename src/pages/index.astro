---
import Layout from "../layouts/Layout.astro";
import VasterShowcase from "../components/VasterShowcase.astro";
import WorkflowVisual from "../components/WorkflowVisual.astro";
import ProjectCTA from "../components/ProjectCTA.astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts } from '../lib/posts';
import { siteIdentity } from '../lib/seo';
import { services, engagement } from '../lib/business';

export const prerender = true;

// Hand-picked for an operations reader; falls back to the latest posts if a slug is renamed or unpublished.
const featuredSlugs = [
  'design-ai-workflows-like-access-can-break',
  'if-ai-saves-time-why-does-the-workday-keep-expanding',
  'agent-experience-designing-for-two-users',
];
const published = await getPublishedPosts();
const featured = published.filter(post => featuredSlugs.includes(post.id));
const homePosts = [...featured, ...published.filter(post => !featured.includes(post))].slice(0, 3);

// Each control is implemented in the Vaster work; sources are listed in docs/vaster-showcase.md.
const controls = [
  { title: 'Sensitive data stays masked.', text: 'Revealing an SSN takes a recorded credit authorization and a stated reason. The value hides again after 30 seconds.' },
  { title: 'Agent changes need approval.', text: 'Oscar is limited to authorized operations staff, and its updates and document attachments wait for approval.' },
  { title: 'Decisions stay with people.', text: 'Borrower consent and lending decisions are never handed to the system.' },
];
---
<Layout title={siteIdentity.title} description={siteIdentity.description} nav="home">
  <main id="main-content" class="transformation-page">
        <section class="hero dark-surface">
            <div class="site-container hero-grid">
                <div class="hero-copy">
                    <p class="eyebrow"><span class="signal-dot"></span> FOR COMPANIES PUTTING AI INTO THE OPERATION</p>
                    <h1>Put AI to work<br /><span>across the operation.</span></h1>
                    <p class="hero-lead">We plan, build, and run the systems that carry AI into daily work: connected to your records, governed by your people, and delivered by a team sized to the job.</p>
                    <div class="hero-actions">
                        <a class="action action-lime" href="/contact">Talk to us about your operation <span aria-hidden="true">↗</span></a>
                        <a class="text-action" href="/work">See the work <span aria-hidden="true">↗</span></a>
                    </div>
                    <ul class="hero-proof" aria-label="What you get"><li>Strategy through delivery</li><li>Wired into your systems of record</li><li>Your people stay in control</li></ul>
                </div>
                <WorkflowVisual />
            </div>
        </section>
    <section id="services" class="home-directory opportunities home-offer"><div class="site-container">
      <div class="section-heading"><div><p class="section-kicker">WHAT WE DO</p><h2>One program.<br />Three stages.</h2></div><a class="text-action light-link" href="/services">See how each stage works <span aria-hidden="true">↗</span></a></div>
      <div class="directory-grid">{services.map(service => <a href={`/services#service-${service.number}`}><span class="section-kicker">{service.number} / {service.tag}</span><h3>{service.title}</h3><p>{service.summary}</p><span class="directory-link">{service.deliverables[0]} ↗</span></a>)}</div>
    </div></section>
    <section class="section-pad site-container">
      <div class="section-heading"><div><p class="section-kicker">THE WORK / VASTER</p><h2>One lending operation, connected from intake to signature.</h2><p class="section-deck">One program, delivered as workstreams: a loan application wired into HubSpot, Encompass, Box Sign, and Slack, and expense capture for the finance team.</p></div><a class="text-action light-link" href="/work/vaster">View the Vaster case study <span aria-hidden="true">↗</span></a></div>
      <VasterShowcase detailLink={false} />
            <a class="related-project" href="/work/expenses"><div><span class="section-kicker">SAME PROGRAM / FINANCE OPERATIONS</span><h3>Vaster Expenses <span aria-hidden="true">↗</span></h3><p>AI-assisted receipt capture, connected evidence, and a clear handoff to approval and finance.</p><span class="related-project-path" aria-hidden="true">CAPTURE → APPROVE → FINANCE</span></div></a>
    </section>
    <section id="engagement" class="engage-band dark-surface section-pad"><div class="site-container">
      <div class="engage-heading"><div><p class="section-kicker">HOW WE ENGAGE</p><h2>A team built<br />for the scope.</h2></div><div><p>A program needs more than one pair of hands, and one person answerable for the result. Every engagement has both.</p><a class="text-action" href="/about">Meet the founder <span aria-hidden="true">↗</span></a></div></div>
      <div class="engage-grid">{engagement.map(item => <article><span class="engage-label">{item.label}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
      <div class="engage-controls">
        <div class="engage-controls-head"><span class="engage-label">CONTROLS, AS BUILT FOR VASTER</span><a class="text-action" href="/work/vaster#identity-consent">See them in the case study <span aria-hidden="true">↗</span></a></div>
        <ul>{controls.map(control => <li><strong>{control.title}</strong><span>{control.text}</span></li>)}</ul>
      </div>
    </div></section>
        <section class="section-pad site-container insights-section"><div class="section-heading"><div><p class="section-kicker">FROM THE BUILD</p><h2>Thinking, tested in practice.</h2></div><a class="text-action light-link" href="/blog">Explore all insights <span aria-hidden="true">↗</span></a></div><PostList posts={homePosts} showReadingTime /></section>
    <ProjectCTA />
  </main>
</Layout>
<style>
  .home-offer {padding-top:clamp(3.5rem,6vw,5rem);}
  .home-offer .section-heading {margin-bottom:.5rem;}
  .engage-heading {display:grid;grid-template-columns:1.2fr 1fr;gap:4rem;align-items:end;}
  .engage-band .section-kicker, .engage-label {color:var(--lime);}
  .engage-label {display:block;font:.6875rem/1.6 var(--font-mono);letter-spacing:.08em;}
  .engage-heading p:not(.section-kicker) {color:#b9c8ae;font-size:1.0625rem;line-height:1.8;max-width:44ch;margin-bottom:.75rem;}
  .engage-grid {display:grid;grid-template-columns:repeat(3,1fr);gap:3rem;margin-top:3.5rem;}
  .engage-grid article {padding-top:1.5rem;border-top:1px solid #4a5b40;}
  .engage-grid h3 {font:500 1.35rem/1.4 var(--font-display);letter-spacing:-.04em;margin-block:1.1rem .9rem;}
  .engage-grid p {font-size:.95rem;line-height:1.85;color:#b7c3ad;}
  .engage-controls {margin-top:3.5rem;padding:1.75rem 2rem;background:#1c2319;border:1px solid #3c4a33;border-radius:5px;}
  .engage-controls-head {display:flex;align-items:center;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;}
  .engage-controls ul {list-style:none;margin:1.25rem 0 0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:3rem;}
  .engage-controls li {display:flex;flex-direction:column;gap:.5rem;}
  .engage-controls strong {font:500 1rem/1.5 var(--font-display);letter-spacing:-.02em;color:#f0f3ec;}
  .engage-controls li span {font-size:.875rem;line-height:1.8;color:#b5c0aa;}
  @media(max-width:850px){.engage-heading {grid-template-columns:1fr;gap:1.5rem;}.engage-grid,.engage-controls ul {grid-template-columns:1fr;gap:2rem;}.engage-controls {padding:1.3rem;}}
</style>
