---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

// Held until Daniel approves how Vaster is named on this page.
const showNamedProof = false;
---
<Layout title="Private Lending Systems | Zulo" description="We build the staff workspace that pulls a deal from your CRM, checks the documents against it, and drafts the committee packet. Your team still makes every credit decision." nav="lending">
	<main id="main-content" class="transformation-page">
		<section class="hero dark-surface lending-hero">
			<div class="site-container hero-grid">
				<div class="hero-copy">
					<p class="eyebrow"><span class="signal-dot"></span> FOR PRIVATE LENDERS.</p>
					<h1>Stop rebuilding the same loan<br />in five places.</h1>
					<p class="hero-lead">We build the staff workspace that pulls a deal from your CRM, checks the documents against it, and drafts the committee packet. Your team still makes every credit decision.</p>
					<div class="hero-actions">
						<a class="action action-lime" href="/contact">Walk me through one of your files <span aria-hidden="true">↗</span></a>
						<a class="text-action" href="/work/vaster-agent">See the Vaster workspace <span aria-hidden="true">↗</span></a>
					</div>
					{showNamedProof && <ul class="hero-proof" aria-label="Proof"><li>Built for Vaster, a private bridge lender</li><li>20 years building software</li></ul>}
				</div>
				<figure class="loan-board" aria-label="Illustration of a committee packet. Sample data.">
					<div class="loan-board-top"><span>SAMPLE PACKET</span><span>ILLUSTRATION</span></div>
					<div class="loan-sheet">
						<p class="sheet-kicker">Committee brief · sample data</p>
						<p class="sheet-title">Example Holdings</p>
						<p class="sheet-line">Sample bridge · one property</p>
						<dl>
							<div><dt>Loan amount</dt><dd>SAMPLE</dd></div>
							<div><dt>Value</dt><dd>SAMPLE</dd></div>
							<div><dt>LTV</dt><dd>Calculated</dd></div>
							<div><dt>Sources and uses</dt><dd>Calculated</dd></div>
						</dl>
						<p class="sheet-status">Draft for a person to edit</p>
					</div>
					<figcaption><span class="signal-dot"></span> Illustration. Sample data. Not a client result.</figcaption>
				</figure>
			</div>
		</section>
		<section class="section-pad site-container lending-offer">
			<h2>We’ll mock up a committee packet from a sample deal.</h2>
			<p>Send one of your files, or start from the sample above. We mark the places the deal gets retyped, then draft the packet your committee would open. The picture uses sample data. The credit decision stays with your team.</p>
		</section>
		<section class="closing-section dark-surface">
			<div class="site-container closing-inner">
				<p class="eyebrow"><span class="signal-dot"></span> THE NEXT STEP</p>
				<h2>Send one loan file.<br />We’ll show you where it gets retyped, and mock up the fix on sample data, free.</h2>
				<div class="closing-bottom">
					<a class="action action-lime" href="/contact">Send me a file walkthrough <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</section>
	</main>
</Layout>
<style>
	.lending-hero .hero-lead { max-width: 42ch; }
	.loan-board {
		display: flex;
		flex-direction: column;
		width: 100%;
		border: 1px solid #394333;
		border-radius: 6px;
		background: #1a2018;
		overflow: hidden;
	}
	.loan-board-top, .loan-board figcaption {
		display: flex;
		justify-content: space-between;
		gap: .75rem;
		padding: .7rem 1rem;
		font: .65rem/1.6 var(--font-mono);
		letter-spacing: .06em;
		color: #acb99f;
	}
	.loan-board-top { background: #171e13; }
	.loan-board figcaption {
		justify-content: flex-start;
		align-items: center;
		gap: .5rem;
		border-top: 1px solid #36462b;
		background: #171e13;
	}
	.loan-sheet { padding: 1.25rem 1.35rem 1.4rem; }
	.sheet-kicker {
		margin: 0;
		font: .65rem/1.6 var(--font-mono);
		letter-spacing: .08em;
		color: #a8bd96;
	}
	.sheet-title {
		margin: .7rem 0 0;
		font: 500 1.7rem/1.2 var(--font-display);
		letter-spacing: -.04em;
	}
	.sheet-line { margin: .35rem 0 0; color: #b7c3ad; }
	.loan-sheet dl { margin: 1.1rem 0 0; }
	.loan-sheet dl div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-block: .55rem;
		border-top: 1px solid #36462b;
		font-size: .92rem;
	}
	.loan-sheet dt { color: #b7c3ad; }
	.loan-sheet dd { margin: 0; font-weight: 500; }
	.sheet-status { margin: 1rem 0 0; color: var(--lime); font-size: .85rem; }
	.lending-offer { max-width: 78rem; }
	.lending-offer h2 { max-width: 18ch; }
	.lending-offer p {
		max-width: 58ch;
		margin-top: 1.25rem;
		color: var(--color-muted);
		font-size: 1.125rem;
		line-height: 1.75;
	}
	@media (max-width: 640px) {
		.lending-hero .hero-grid { padding-block: 1rem .85rem; gap: .7rem; }
		.lending-hero .eyebrow { margin-bottom: .5rem; }
		.lending-hero h1 { font-size: 1.9rem; }
		.lending-hero .hero-lead { margin-top: .6rem; font-size: .95rem; line-height: 1.45; }
		.lending-hero .hero-actions { margin-top: .7rem; gap: .25rem .9rem; }
		.loan-board-top, .loan-board figcaption { padding: .4rem .85rem; }
		.loan-sheet { padding: .6rem .85rem .65rem; }
		.sheet-title { margin-top: .35rem; font-size: 1.2rem; }
		.sheet-line { margin-top: .15rem; }
		.loan-sheet dl { margin-top: .6rem; }
		.loan-sheet dl div { padding-block: .22rem; font-size: .85rem; }
		.sheet-status { margin-top: .5rem; }
	}
</style>
