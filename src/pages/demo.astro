---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

type AudienceIllustration = {
  readonly audience: string;
  readonly friction: string;
  readonly sample: string;
  readonly proof?: {
    readonly href: '/work/expenses';
    readonly label: string;
  };
};

type WithProof = AudienceIllustration & {
  readonly proof: { readonly href: '/work/expenses'; readonly label: string };
};

type WithoutProof = Omit<AudienceIllustration, 'proof'>;

type DemoStep = {
  readonly title: string;
  readonly text: string;
  readonly output: string;
};

type DemoSteps = readonly [DemoStep, DemoStep, DemoStep];

const bookkeeping = {
  audience: 'For bookkeeping and CPA firms',
  friction: 'Documents come in late. Receipts don’t match the books. Someone spends the day chasing both.',
  sample: 'The demo sets sample receipts next to sample book entries and marks the ones that don’t agree.',
  // TODO: add a credit-card transaction case study when that work can be shown.
  proof: {
    href: '/work/expenses',
    label: 'Vaster Expenses is the closest shipped work for receipt capture and a handoff to finance.',
  },
} as const satisfies WithProof;

const propertyManagement = {
  audience: 'For property management',
  friction: 'Owners ask what happened. Repair requests arrive by text, phone, and email, and the next step sits with whoever saw them first.',
  sample: 'The demo turns a sample repair text into an owner update and holds it until the manager says it can go.',
} as const satisfies WithoutProof;

const trades = {
  audience: 'For trades',
  friction: 'A quote goes out, and the next call doesn’t. The job sits while the crew is on another site.',
  sample: 'The demo keeps each sample quote on a list with the date it went out, and it drafts the note a person would send next.',
} as const satisfies WithoutProof;

const illustrations = [bookkeeping, propertyManagement, trades] as const satisfies readonly [
  WithProof,
  WithoutProof,
  WithoutProof,
];

const demoSteps = [
  {
    title: 'Tell us what drags',
    text: 'Name the follow-up, the paperwork, or the handoff. The contact form is enough to start.',
    output: 'One workflow',
  },
  {
    title: 'We build it on sample data',
    text: 'The demo runs on made-up records. Your customer files stay put for this step.',
    output: 'A working demo',
  },
  {
    title: 'You get it by email',
    text: 'We send the demo to the email you gave us. There is no charge.',
    output: 'A demo in your inbox',
  },
] as const satisfies DemoSteps;
---
<Layout
  title="Free Demo on Sample Data | Zulo"
  description="Name the follow-up, paperwork, or handoff that drags. Zulo builds a free demo with sample data and emails it to you. A later build is scoped to the work, with no price on this page."
>
  <main id="main-content" class="transformation-page">
    <section class="page-masthead site-container">
      <p class="section-kicker">FREE DEMO</p>
      <h1>See it on sample data<br />before you spend anything.</h1>
      <p class="page-lead">We build it with sample data, email it to you, and charge nothing for that step. You see the workflow before you decide on a build.</p>
    </section>
    <section class="section-pad site-container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">WHAT THIS LOOKS LIKE</p>
          <h2>What this looks like.</h2>
        </div>
        <p>Illustrations, not client case studies.</p>
      </div>
      <div class="illustrations">
        {illustrations.map((item) => (
          <article>
            <h3>{item.audience}</h3>
            <p>{item.friction}</p>
            <p>{item.sample}</p>
            {'proof' in item && item.proof ? (
              <a class="text-action light-link" href={item.proof.href}>
                {item.proof.label} <span aria-hidden="true">↗</span>
              </a>
            ) : null}
          </article>
        ))}
      </div>
    </section>
    <section class="section-pad site-container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">HOW THE DEMO WORKS</p>
          <h2>Three steps. Then it’s yours to judge.</h2>
        </div>
      </div>
      <ol class="steps demo-steps">
        {demoSteps.map((step, index) => (
          <li>
            <span class="step-number">0{index + 1}<span aria-hidden="true">↗</span></span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <div class="step-output">{step.output}</div>
          </li>
        ))}
      </ol>
    </section>
    <section class="section-pad site-container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">A PAID NEXT STEP</p>
          <h2>Fees are scoped to the work.</h2>
        </div>
        <p>If the demo is useful, the next step is a build on your real process. We agree on a defined problem, deliverables, and success measures. Timing and fees are scoped to the work. No price is listed here.</p>
      </div>
      <a class="text-action light-link" href="/services#opportunities">Real work <span aria-hidden="true">↗</span></a>
    </section>
    <section class="section-pad site-container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">WRITE TO DANIEL</p>
          <h2>Send the process that takes too long.</h2>
        </div>
        <p>Use the contact form, or email daniel@zulo.dev.</p>
      </div>
      <div class="flex flex-wrap items-center gap-lg">
        <a class="action action-lime" href="/contact">Go to the contact form <span aria-hidden="true">↗</span></a>
        <a class="text-action light-link" href="mailto:daniel@zulo.dev">daniel@zulo.dev <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</Layout>
<style>
  .illustrations { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .illustrations article { border-top: 1px solid #b9c6ae; padding-top: 1.5rem; }
  .illustrations h3 { font: 500 1.45rem/1.4 var(--font-display); letter-spacing: -.04em; margin-bottom: 1rem; }
  .illustrations p { color: var(--color-muted); font-size: .9375rem; line-height: 1.85; margin-bottom: 1rem; }
  .demo-steps { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 850px) {
    .illustrations { grid-template-columns: 1fr; }
    .demo-steps { grid-template-columns: 1fr; }
  }
</style>
