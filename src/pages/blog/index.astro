---
import Layout from '../../layouts/Layout.astro'
import PageShell from '../../components/ui/PageShell.astro'
import PostList from '../../components/PostList.astro'
import { getPublishedPosts } from '../../lib/posts'

export const prerender = true;
import { accentLink, displayTitle, proseBody } from '../../lib/classes'

const posts = await getPublishedPosts();
---

<Layout pageType="CollectionPage" title="Applied AI & Agentic Workflows: Insights | Zulo" description="Notes on building with AI agents, agentic workflows, and the judgment calls that still belong to people." nav="blog">
  <main id="main-content">
    <PageShell class="py-page-intro">
      <div class="flex flex-col gap-md">
        <h1 class={displayTitle}>Field notes on applied AI</h1>
        <p class={proseBody}>
          Notes on agentic workflows, product design when software can run the work, and what still requires human judgment.
          Subscribe via <a class={accentLink} href="/rss.xml">RSS</a>.
        </p>
      </div>
    </PageShell>

    <PageShell class="py-section pb-section-lg">
      <PostList posts={posts} showReadingTime />
    </PageShell>
  </main>
</Layout>
