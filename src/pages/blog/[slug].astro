---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPublishedPosts } from '../../lib/posts';
import { readingTimeMinutes } from '../../lib/reading-time';

export const prerender = true;
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newerPost: posts[index - 1], olderPost: posts[index + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newerPost, olderPost } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  slug={post.id}
  {...post.data}
  minutes={readingTimeMinutes(post.body ?? '')}
  newerPost={newerPost ? { slug: newerPost.id, title: newerPost.data.title } : undefined}
  olderPost={olderPost ? { slug: olderPost.id, title: olderPost.data.title } : undefined}
>
  <Content />
</BlogPost>
