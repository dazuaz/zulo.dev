---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import FormField from '../components/ui/FormField.astro';
import { accentLink, displayTitle, fieldError, proseBody, sectionTitle } from '../lib/classes';
import { cn } from '../lib/utils';

export const prerender = true;
---

<Layout
  title="Contact Daniel Zuloaga for AI Strategy & Systems | Zulo"
  pageType="ContactPage"
  description="Talk with Daniel Zuloaga about AI strategy, workflow automation, and custom systems for your business."
  nav="contact"
>
  <main id="main-content">
    <section class="site-container section-pad contact-layout">
      <div class="contact-intro"><p class="section-kicker">LET’S BUILD SOMETHING USEFUL</p><h1 class={displayTitle}>Your next chapter<br />starts with a<br />conversation.</h1><p>Tell me about the work you want to improve, what’s getting in the way, and what a better outcome would mean for your team.</p><div class="contact-next"><h2>What happens next</h2><ol><li>I’ll review your note and follow up by email.</li><li>We’ll talk through the problem and see whether there’s a fit.</li><li>If there is, we’ll define a useful first step together.</li></ol><a class="text-action light-link" href="https://www.linkedin.com/in/daniel-zuloaga/" target="_blank" rel="noopener noreferrer">Connect with Daniel on LinkedIn <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a></div></div>
      <div class="contact-panel">
        <div id="contact-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
        <form id="contact-form" class="flex flex-col gap-lg" novalidate>
          <FormField id="name" label="Your name" required maxlength="120" autocomplete="name" />
          <FormField id="email" label="Email" type="email" required maxlength="254" autocomplete="email" />
          <FormField id="message" label="What would you like to improve?" placeholder="A process that takes too long, a tool your team needs, or an AI idea you want to explore…" required textarea rows="7" maxlength="5000" />
          <p id="contact-error" class={cn(fieldError, 'hidden')} role="alert"></p>
          <div><Button type="submit" id="contact-submit"><span id="contact-submit-label">Start the conversation ↗</span></Button></div>
        </form>
        <p class="contact-form-note">Your message goes directly to Daniel.</p>
        <noscript><p class="mt-lg">Please enable JavaScript to send this form, or use the LinkedIn link to connect.</p></noscript>
        <div id="contact-success" class="hidden flex flex-col gap-md" role="region" aria-labelledby="contact-success-heading"><h2 id="contact-success-heading" class={sectionTitle} tabindex="-1">Thanks. Let’s see what’s possible.</h2><p class={proseBody}>Your message has been received. I’ll reply to the email you provided. In the meantime, explore the <a class={accentLink} href="/blog">latest insights</a>.</p></div>
      </div>
    </section>
  </main>

  <script>
    type FieldName = 'name' | 'email' | 'message';

    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const submitLabel = document.getElementById('contact-submit-label');
    const errorEl = document.getElementById('contact-error');
    const successEl = document.getElementById('contact-success');
    const statusEl = document.getElementById('contact-status');
    const successHeading = document.getElementById('contact-success-heading');

    const fields: FieldName[] = ['name', 'email', 'message'];

    function announceStatus(message: string) {
      if (statusEl) statusEl.textContent = message;
    }

    function clearFieldErrors() {
      for (const field of fields) {
        const input = document.getElementById(field) as HTMLInputElement | HTMLTextAreaElement | null;
        const fieldError = document.getElementById(`${field}-error`);
        if (input) {
          input.removeAttribute('aria-invalid');
        }
        if (fieldError) {
          fieldError.textContent = '';
          fieldError.classList.add('hidden');
        }
      }
      if (errorEl) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }
    }

    function setFieldError(field: FieldName, message: string) {
      const input = document.getElementById(field) as HTMLInputElement | HTMLTextAreaElement | null;
      const fieldError = document.getElementById(`${field}-error`);
      if (input) {
        input.setAttribute('aria-invalid', 'true');
        input.focus();
      }
      if (fieldError) {
        fieldError.textContent = message;
        fieldError.classList.remove('hidden');
      }
      announceStatus(message);
    }

    function mapErrorToField(message: string): FieldName | null {
      const lower = message.toLowerCase();
      if (lower.includes('name is required')) return 'name';
      if (lower.includes('valid email') || lower.includes('email is required')) return 'email';
      if (lower.includes('message is required')) return 'message';
      return null;
    }

    function validateClient(payload: { name: string; email: string; message: string }) {
      if (!payload.name.trim()) {
        setFieldError('name', 'Name is required.');
        return false;
      }
      if (!payload.email.trim()) {
        setFieldError('email', 'Email is required.');
        return false;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email)) {
        setFieldError('email', 'Enter a valid email address.');
        return false;
      }
      if (!payload.message.trim()) {
        setFieldError('message', 'Message is required.');
        return false;
      }
      return true;
    }

    if (form && submitBtn && submitLabel && errorEl && successEl) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearFieldErrors();

        const data = new FormData(form);
        const payload = {
          name: String(data.get('name') ?? ''),
          email: String(data.get('email') ?? ''),
          message: String(data.get('message') ?? ''),
        };

        if (!validateClient(payload)) return;

        submitBtn.disabled = true;
        submitLabel.textContent = 'Sending…';
        announceStatus('Sending your message.');

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (res.ok) {
            form.classList.add('hidden');
            successEl.classList.remove('hidden');
            announceStatus('Thanks, your message is on its way.');
            successHeading?.focus();
            return;
          }

          let message = 'Something went wrong. Please try again, or connect using the LinkedIn link.';
          let field: FieldName | null = null;
          try {
            const body = await res.json();
            if (body && typeof body.error === 'string') message = body.error;
            if (body && typeof body.field === 'string' && fields.includes(body.field)) {
              field = body.field as FieldName;
            }
          } catch {
            /* ignore */
          }

          const mappedField = field ?? mapErrorToField(message);
          if (mappedField) {
            setFieldError(mappedField, message);
          } else {
            errorEl.textContent = message;
            errorEl.classList.remove('hidden');
            announceStatus(message);
          }
        } catch (err) {
          console.error('Contact form submit failed:', err);
          const networkMessage =
            'Network error. Check your connection and try again.';
          errorEl.textContent = networkMessage;
          errorEl.classList.remove('hidden');
          announceStatus(networkMessage);
        } finally {
          submitBtn.disabled = false;
          submitLabel.textContent = 'Start the conversation ↗';
        }
      });
    }
  </script>
</Layout>
